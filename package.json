{
  "name": "falkyria-games",
  "version": "2.1.0",
  "private": true,
  "description": "Falkyria Games: um fliperama inteiro no navegador.",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node tests/helpers/server.js",
    "test": "npm run test:unit && npm run test:e2e && npm run test:db",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.js\"",
    "test:db": "node --test --test-concurrency=1 \"tests/db/*.test.js\""
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
